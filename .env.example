# GhostLink / gmp-core environment variables — reference template
#
# ⚠  NEVER COMMIT REAL VALUES. Copy this file to `.env` (which is gitignored)
#    or export the variables in your shell / service manager. Nothing in the
#    repo loads `.env` automatically — gmp-core reads plain process.env, so use
#    e.g. `set -a; . ./.env; set +a; npm start` or a systemd EnvironmentFile.
#
# Every variable is optional. The values shown are the built-in defaults; an
# empty value means "unset" (the default behaviour described next to it).
# Defaults can also come from gmp-core's config.json (see GMP_CONFIG_PATH);
# environment variables take precedence over that file.

# ── Local bridge (WebSocket between the web/desktop UI and the mesh node) ──

# Interface the bridge binds to. Keep it on loopback. 0.0.0.0 enables "LAN
# mode" (private-range clients accepted) — trusted LANs only, never the internet.
GMP_BRIDGE_HOST=127.0.0.1

# Port the bridge listens on (start_https.sh reads the same variable).
GMP_BRIDGE_PORT=3002

# TLS certificate and key for the bridge (wss://). Both must be set to take
# effect; otherwise cert.pem/key.pem are looked up in gmp-core/ and the repo
# root. Private keys are gitignored (*.pem) — keep them that way.
GMP_BRIDGE_CERT=
GMP_BRIDGE_KEY=

# Set to 1 to accept the opaque "null" Origin. SECURITY: while this is on, any
# website can reach the bridge from a sandboxed iframe. Leave unset.
GMP_BRIDGE_ALLOW_NULL_ORIGIN=

# ── State and configuration paths ──

# Directory for all mutable node state (peer cache, nonce state, claim log,
# config). Default: <gmp-core>/data. The packaged desktop app defaults this to
# the per-user data dir, because the install directory is read-only.
GMP_DATA_DIR=

# Individual file overrides. Each defaults to a file inside GMP_DATA_DIR:
GMP_CONFIG_PATH=           # default: $GMP_DATA_DIR/config.json
GMP_PUBLIC_PEERS_PATH=     # default: $GMP_DATA_DIR/public-peers.json
GMP_PEER_CACHE_PATH=       # default: $GMP_DATA_DIR/peer-cache.json
GMP_NONCE_STATE_PATH=      # default: $GMP_DATA_DIR/nonce-state.json
GMP_NONCE_CLAIMS_PATH=     # default: $GMP_DATA_DIR/nonce-claims.log
# Nonce state and the claim log are replay protection. Put them on durable
# storage and never share them between two running nodes.

# ── Identity ──

# 12-word BIP-39 seed phrase for the gmp CLI node. This IS the node's private
# identity — anyone holding it can impersonate the node and read its traffic.
# Prefer entering it at the interactive prompt. If you must use the variable,
# inject it from a secret manager; never write a real phrase into any file
# under version control.
GMP_SEED_PHRASE=

# ── Public peer / diagnostics ──

# UDP port for a public-peer node (`gmp` CLI public mode). Default: config
# GMP_PORT, else 49500. Many PaaS hosts set PORT for you.
PORT=

# Set to 1 or true to check claim-log invariants after every mutation (always
# on when NODE_ENV=test). Diagnostics only; small per-write cost.
GMP_DEBUG_ASSERTS=
